#!/usr/bin/env sh
# Strip Cursor agent co-author trailers from commit messages (REQ-GIT-001).
set -eu

MSG_FILE="${1:?commit message file required}"
tmp="$(mktemp)"

sed -E \
  -e '/^Co-authored-by:[[:space:]]*.*[Cc]ursor/Id' \
  -e '/^Co-authored-by:[[:space:]]*.*@cursor\.(com|so)/Id' \
  -e '/^[Cc]o-[Aa]uthored-[Bb]y:.*[Cc]laude/d' \
  -e '/^[Cc]o-[Aa]uthored-[Bb]y:.*anthropic\.com/d' \
  -e '/^Made-with:[[:space:]]*[Cc]ursor/Id' \
  "$MSG_FILE" > "$tmp"

mv "$tmp" "$MSG_FILE"
exit 0

{% extends 'base.html.twig' %}
{% block title %}{{ heading }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('homepage') }}">Home</a>
        <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('demo_status') }}">Status JSON</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: heading, intro: description, toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Event', intro: (note is defined and note) ? note : null, kind: 'detail', enabled: enabled, level: level, eventId: eventId ?? null, fingerprint: fingerprint} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <tbody>
                    <tr><th scope="row">Client enabled</th><td><span class="nowo-ui-badge nowo-ui-badge--{{ enabled ? 'success' : 'neutral' }}">{{ enabled ? 'yes' : 'no' }}</span></td></tr>
                    <tr><th scope="row">Level</th><td><code class="nowo-ui-code">{{ level }}</code></td></tr>
                    <tr><th scope="row">Event id</th><td class="nowo-ui-cell--wrap"><code class="nowo-ui-code">{{ eventId ?? 'null (DSN empty, disabled, or assigned inside a listener)' }}</code></td></tr>
                    {% if fingerprint is not empty %}
                        <tr><th scope="row">Fingerprint</th><td class="nowo-ui-cell--wrap"><code class="nowo-ui-code">{{ fingerprint|join(', ') }}</code></td></tr>
                    {% endif %}
                </tbody>
            </table>
        {% endblock %}
        {% block section_footer %}
            <p class="nowo-ui-muted">Event ids are generated locally before transport. For TLS failures, missing DSN secret, rejected keys (401) or suspended project ingestion (403), verify delivery in Beacon Issues / Performance or in application logs. Auth uses <code class="nowo-ui-code">X-Beacon-Auth</code> (<code class="nowo-ui-code">beacon_key</code> + <code class="nowo-ui-code">beacon_secret</code>).</p>
        {% endblock %}
    {% endembed %}
{% endblock %}

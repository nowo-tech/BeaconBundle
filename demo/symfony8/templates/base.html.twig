{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Beacon',
    home_route: 'homepage',
    repository: 'https://github.com/nowo-tech/BeaconBundle',
    translation_domain: false,
    locales: [],
    auth: {login_route: 'login', logout_route: 'logout'},
    nav: [
        {label: 'Home', route: 'homepage'},
        {label: 'Report', route: 'demo_report', section: 'Scenarios'},
        {label: 'Status (JSON)', route: 'demo_status', section: 'Diagnostics'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}Beacon Bundle Demo{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/nowopasswordtoggle/css/toggle_password.css') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('app') }}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Demo login', intro: 'Try debugger / debug or viewer / viewer.'}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Sign in', kind: 'form', error: error, loginForm: loginForm} %}
        {% block section_body %}
            {% if error %}
                <div class="nowo-ui-flash nowo-ui-flash--error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            {{ form_start(loginForm, {attr: {id: 'demo-login-form'}}) }}
                {% for child in loginForm %}
                    {% if not child.rendered and child.vars.name != 'submit' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(loginForm, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="demo-login-form" class="nowo-ui-btn nowo-ui-btn--primary">Sign in</button>
        {% endblock %}
    {% endembed %}
{% endblock %}

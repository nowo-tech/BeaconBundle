{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header"><h1 class="nowo-ui-card__title">Demo login</h1></div>
        <div class="nowo-ui-card__body">
            {% if error %}
                <div class="nowo-ui-flash nowo-ui-flash--error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {{ form_start(loginForm) }}
                {% for child in loginForm %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(loginForm) }}

            <p class="nowo-ui-muted">Try <code class="nowo-ui-code">debugger / debug</code> or <code class="nowo-ui-code">viewer / viewer</code>.</p>
        </div>
    </section>
{% endblock %}
